{
    "easy": [
        {
            "snippet": "body { margin: 0; }"
        },
        {
            "snippet": ".hidden { display: none; }"
        },
        {
            "snippet": "img { max-width: 100%; }"
        },
        {
            "snippet": ".center { text-align: center; }"
        }
    ],
    "easy-medium": [
        {
            "snippet": "body { background-color: black; }"
        },
        {
            "snippet": ".container { display: flex; }"
        },
        {
            "snippet": ".start-btn { background-color: orange; }"
        },
        {
            "snippet": ".score { font-size: 2rem; }"
        },
        {
            "snippet": ".score { font-weight: bold; }"
        },
        {
            "snippet": ".player { color: white; }"
        }
    ],
    "medium": [
        {
            "snippet": "#gameCanvas { width: 100%; height: 100vh; }"
        },
        {
            "snippet": "#game { width: 800px; height: 600px; }"
        },
        {
            "snippet": "h1 { color: white; font-size: 48px; }"
        },
        {
            "snippet": ".asteroid { position: absolute; top: 0; }"
        },
        {
            "snippet": ".asteroid { border-radius: 50%; }"
        },
        {
            "snippet": "nav a { text-decoration: none; }"
        }
    ],
    "medium-hard": [
        {
            "snippet": "button:hover { background-color: blue; }"
        },
        {
            "snippet": "p { margin: 10px; padding: 5px; }"
        },
        {
            "snippet": ".menu { display: flex; gap: 1rem; }"
        },
        {
            "snippet": "input:focus { outline: 2px solid cyan; }"
        },
        {
            "snippet": ".panel { padding: 16px; border: 1px solid #ccc; }"
        },
        {
            "snippet": ".menu { border-radius: 10px; }"
        },
        {
            "snippet": ".title { letter-spacing: 0.08em; }"
        }
    ],
    "hard": [
        {
            "snippet": ".health-bar { height: 20px; background: limegreen; }"
        },
        {
            "snippet": ".game-over { color: red; text-align: center; }"
        },
        {
            "snippet": ".player { animation: float 2s infinite; }"
        },
        {
            "snippet": "button:hover { transform: scale(1.05); }"
        },
        {
            "snippet": "@media (max-width: 600px) { .menu { flex-direction: column; } }"
        }
    ]
}
